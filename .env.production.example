# ==============================================================================
# BACKEND DEPLOYMENT ENVIRONMENT VARIABLES (For Render / Railway)
# ==============================================================================
# Paste these into your backend service's "Environment Variables" settings:

NODE_ENV=production
PORT=5000

# Connection string to your cloud PostgreSQL database (e.g. from Neon.tech, Supabase, or Railway)
# Example: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/projectsync_db?sslmode=require
DATABASE_URL=your_hosted_postgres_database_url_here

# The live URL of your deployed frontend on Vercel
# Example: https://projectsync.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app

# Cryptographically generated 256-bit secrets for signing tokens
JWT_ACCESS_SECRET=0dac12ee6508bdc9a026275cffbcdc659c31ad53d94854775eb51cfc4faa2af7
JWT_REFRESH_SECRET=08f68798f0be87c779010deaff7c698f4e4ff15e4019714bb941cb6ad4a5105f

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ==============================================================================
# FRONTEND DEPLOYMENT ENVIRONMENT VARIABLES (For Vercel)
# ==============================================================================
# Paste this single variable into Vercel Project Settings -> Environment Variables:

# The live URL of your deployed backend service (e.g. from Render or Railway)
# Example: https://projectsync-backend.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com
